@inproceedings{wei2025agenticmethod,
  author       = {Wei, Kevin and Guth, Stephen and Wu, Gabriel and Paskov, Patricia},
  title        = {Methodological Challenges in Agentic Evaluations of {AI} Systems},
  booktitle    = {ICML Workshop on Technical AI Governance (TAIG)},
  year         = {2025},
  address      = {Vancouver, Canada},
  url          = {https://openreview.net/forum?id=ZhSKG8IslC},
  note         = {Retrieved and read in full 2026-09-04. Load-bearing for this paper in four
                  places: its environment partition (App. A.3.3) explicitly treats an agent
                  writing a ``note to self'' to a file as a modification of the compute
                  environment rather than an internal step, which is precisely the flow we
                  measure; its ``avoiding trivial solutions'' challenge is the affordance-inflation
                  framing our $\Delta$ operationalises; its ``how does task size affect task
                  performance'' challenge is the context-exhaustion failure we hit; and its
                  analysis section is where we found the citation that corrected our statistical
                  test.},
}

