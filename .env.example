# Provider keys for the behavioural arm. The capacity arm needs none of these.
# Copy to .env and fill in the ones you intend to use.

# --- first-party free tiers (own key, own quota) ---
GEMINI_API_KEY=                 # Gemini Developer API (free tier; per-model request cap)
GROQ_API_KEY=                   # Groq (free; the binding limit is TOKENS per minute, not requests)
NVIDIA_API_KEY=                 # NVIDIA NIM, nvapi-...
OPENROUTER_API_KEY=             # OpenRouter, sk-or-v1-...

# --- aggregator (optional) ---
SK_NAVY_API_KEY=                # NavyAI, sk-nav-... ; platform id in the gateway is `navy`

# --- self-hosted FreeLLMAPI gateway (optional; gives failover across the above) ---
FREELLM_BASE=http://localhost:3001/v1
FREELLM_KEY=                    # the gateway's unified key, freellmapi-...

# --- pacing ---
# Seconds between successive API calls, per process. Raise this when the provider
# meters TOKENS rather than requests: one episode can cost ~50k tokens, and a
# 4s pace against an 8k/min ceiling produces sustained 429s.
ARS_PACE_SECONDS=4
GROQ_API_KEY_2=              # optional; GroqProvider rotates here when the primary
                            # reports day-quota exhaustion. Numbered rather than a
                            # second GROQ_API_KEY= line: load_env routes by key prefix
                            # with setdefault, so a duplicate would be dropped silently.
GROQ_API_KEYS=              # alternative: comma-separated, priority order; wins if set
